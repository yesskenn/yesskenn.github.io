---
import { SOCIALS } from "@/consts";
---

<section id="Contact" class="container mx-auto my-28 space-y-12 p-10">
  <h2 class="my-8 mr-4 text-8xl uppercase md:mr-8 md:text-8xl">Get In Touch</h2>

  <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2">
    <div class="space-y-6">
      <p class="max-w-xl text-xl lg:text-3xl">
        Questions, ideas, or feedback are always welcome. Whether you have a
        question or just want to say hi, my inbox is always open!
      </p>
      <p>
        Open to remote roles where front-end development, design, and
        accessibility overlap.
      </p>

      <div class="space-y-2 text-xl">
        {
          SOCIALS.map((link) => (
            <p>
              <a
                href={link.HREF}
                target="_blank"
                class="underline transition hover:text-secondary"
              >
                {link.NAME}
              </a>
            </p>
          ))
        }
      </div>
    </div>

    <form class="space-y-6">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="relative">
          <input
            type="text"
            id="name"
            name="name"
            class="peer w-full rounded-3xl border border-solid border-secondary p-4 text-xl placeholder-transparent focus:outline-none"
            placeholder="Name"
            required
          />
          <label
            for="name"
            class="absolute top-4 left-4 text-xl text-gray-500 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-xl peer-focus:-top-2 peer-focus:bg-background peer-focus:px-2 peer-focus:text-sm peer-focus:text-secondary"
          >
            Name
          </label>
        </div>

        <div class="relative">
          <input
            type="email"
            id="email"
            name="email"
            class="peer w-full rounded-3xl border border-solid border-secondary p-4 text-xl placeholder-transparent focus:outline-none"
            placeholder="Email"
            required
          />
          <label
            for="email"
            class="absolute top-4 left-4 text-xl text-gray-500 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-xl peer-focus:-top-2 peer-focus:bg-background peer-focus:px-2 peer-focus:text-sm peer-focus:text-secondary"
          >
            Email
          </label>
        </div>
      </div>

      <div class="relative">
        <textarea
          id="message"
          name="message"
          rows="6"
          class="peer w-full resize-none rounded-3xl border border-solid border-secondary p-4 text-xl placeholder-transparent focus:outline-none"
          placeholder="Message"
          required></textarea>
        <label
          for="message"
          class="absolute top-4 left-4 text-xl text-gray-500 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-xl peer-focus:-top-2 peer-focus:bg-background peer-focus:px-2 peer-focus:text-sm peer-focus:text-secondary"
        >
          Message
        </label>
      </div>

      <button
        type="submit"
        class="flex cursor-pointer items-center justify-center rounded-2xl bg-primary px-6 py-3 transition hover:bg-background hover:text-foreground hover:outline hover:outline-1 hover:outline-secondary hover:outline-solid sm:px-10 sm:py-4"
      >
        Send Message
      </button>
    </form>
  </div>
</section>
