---
const { entry } = Astro.props;
---

<li class="border-b border-current/10 px-8 py-8">
  <p class="mb-2 text-sm opacity-60">
    {entry.data.date.toLocaleDateString()}
  </p>
  <a
    class="group relative mb-6 flex flex-col items-center justify-between gap-4 pb-6 md:flex-row md:gap-10"
    href={`/${entry.collection}/${entry.id}`}
  >
    <h3 class="text-2xl font-semibold transition-opacity hover:opacity-80">
      {entry.data.title}
    </h3>

    <p class="leading-relaxed opacity-70 hover:opacity-80">
      {entry.data.description}
    </p>
  </a>
  {
    entry.data.tags && (
      <div class="mt-5 flex flex-wrap gap-2">
        {entry.data.tags.map((tag: any) => (
          <span class="inline-flex items-center justify-center rounded-4xl px-8 py-4 uppercase outline-1 outline-secondary">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</li>
