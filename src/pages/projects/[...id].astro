---
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const allProjects: CollectionEntry<"projects">[] =
    await getCollection("projects");

  return allProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<Layout title={project.data.title} description={project.data.description}>
  <div class="container mx-auto space-y-8 px-6 pt-18">
    <button
      class="my-6 flex cursor-pointer items-center gap-2 pl-2 hover:text-primary"
      title="back"
      id="back-button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-move-left-icon lucide-move-left"
        ><path d="M6 8L2 12L6 16"></path><path d="M2 12H22"></path></svg
      >
      <span>Back</span>
    </button>
    <div
      class="flex flex-col justify-between gap-4 border-b border-dashed border-secondary pb-4 md:flex-row md:items-center"
    >
      <div class="space-y-4">
        <h1 class="text-3xl uppercase md:text-5xl">
          {project.data.title}
        </h1>
        <p>{project.data.description}</p>
      </div>

      <div class="flex flex-col gap-4 sm:flex-row">
        {
          project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              class="flex w-full cursor-pointer items-center justify-center rounded-2xl bg-primary px-6 py-3 transition hover:bg-background hover:text-foreground hover:outline hover:outline-1 hover:outline-secondary hover:outline-solid sm:w-auto sm:px-10 sm:py-4 dark:text-white"
            >
              Source
            </a>
          )
        }

        {
          project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              class="flex w-full cursor-pointer items-center justify-center rounded-2xl bg-foreground px-6 py-3 text-background transition hover:bg-background hover:text-foreground hover:outline hover:outline-1 hover:outline-secondary hover:outline-solid sm:w-auto sm:px-10 sm:py-4"
            >
              Live Demo
            </a>
          )
        }
      </div>
    </div>

    <div
      class="aspect-[610/400] w-full overflow-hidden rounded-2xl lg:h-[70vh]"
    >
      <img
        src={project.data.image.url}
        alt={project.data.image.alt}
        class="h-full w-full object-contain"
      />
    </div>
    <article
      class="mx-auto mb-18 flex-2 border-b border-solid border-secondary px-3"
    >
      <Content />
    </article>
  </div>

  <script is:inline>
    document.getElementById("back-button").addEventListener("click", () => {
      window.history.back();
    });
  </script>
</Layout>
