---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/consts";
---

<Layout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <main class="flex min-h-screen flex-col items-center justify-center gap-4">
    <h1 class="heading text-4xl uppercase">404</h1>
    <p class="text-secondary">Lost in the sauce.</p>
    <p>Page not here, or maybe it never was.</p>
    <a href="/" class="cursor-pointer underline">&larr; Go Back</a>
  </main>
</Layout>
